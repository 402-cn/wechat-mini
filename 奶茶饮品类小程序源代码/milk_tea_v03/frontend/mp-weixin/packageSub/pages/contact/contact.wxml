<view class="mp-shell has-tab"><wxs module="asset" src="../../../utils/mp_asset.wxs"></wxs>
<view class="page">
<view class="title-bar mp-card"><text class="title">联系客服</text><text class="sub">7×12小时在线</text></view>
<view class="notice-bar mp-card" style="color:{{(notice_milk_tea_v03_contact_02.textColor||'#333333')}};background:{{(notice_milk_tea_v03_contact_02.bgColor||'#ffffff')}};font-size:{{(notice_milk_tea_v03_contact_02.fontSize||28)}}rpx">
  <text wx:if="{{notice_milk_tea_v03_contact_02.showIcon !== false}}" class="notice-icon">📢</text>
  <text wx:if="{{notice_milk_tea_v03_contact_02.prefixTitle}}" class="notice-prefix">{{notice_milk_tea_v03_contact_02.prefixTitle}}</text>
  <view class="notice-viewport">
    <view class="notice-track {{notice_milk_tea_v03_contact_02.trackClass || 'to-left'}}" style="animation-duration:{{(notice_milk_tea_v03_contact_02.duration||'4.40s')}}">
      <text class="notice-text">{{notice_milk_tea_v03_contact_02.content || '加载中...'}}</text>
      <text class="notice-text">{{notice_milk_tea_v03_contact_02.content || '加载中...'}}</text>
    </view>
  </view>
</view>
<view class="form-box mp-card message-board"><text class="form-title mb-title">在线留言</text><view class="mb-field"><text class="mb-label">姓名</text><input class="mb-input" type="text" placeholder=""/></view><view class="mb-field"><text class="mb-label">手机号</text><input class="mb-input" type="number" placeholder=""/></view><view class="mb-field"><text class="mb-label">留言内容</text><textarea class="mb-input" placeholder="" auto-height/></view><button class="mb-submit" bindtap="submitForm" data-form-id="contact_milk_tea">提交</button></view>
</view>
<view class="app-modal-mask" wx:if="{{appModalShow}}" catchtouchmove="true">
  <view class="app-modal-box" catchtap="noop">
    <text class="app-modal-title">{{appModalTitle}}</text>
    <text class="app-modal-content">{{appModalContent}}</text>
    <button class="app-modal-btn" bindtap="closeAppModal">确定</button>
  </view>
</view><view class="app-tabbar-mp" wx:if="{{showMpTabBar}}">
  <view wx:for="{{mpTabItems}}" wx:key="page_key" class="tab-item-mp" catchtap="onMpTabSwitch" data-key="{{item.page_key}}">
    <image class="tab-icon-mp" src="{{item.page_key == mpActiveTab ? item.iconActive : item.icon}}" mode="aspectFit"/>
    <text class="tab-text-mp" style="color:{{item.page_key == mpActiveTab ? mpTabPrimary : '#999999'}}">{{item.text}}</text>
  </view>
</view></view>