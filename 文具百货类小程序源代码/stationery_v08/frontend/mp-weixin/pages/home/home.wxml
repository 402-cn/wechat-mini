<wxs module="asset" src="../../utils/mp_asset.wxs"></wxs>
<view class="page page-flush-top">
<view class="page-header mp-card" style="background:#e74c3c"><view class="header-top"><text class="brand">文具优选</text><text>💬</text></view><view class="search-row"><text>📍 当前定位</text><input placeholder="搜索文具百货" confirm-type="search" data-search-type="product"/></view></view>
<view class="swiper-wrap mp-card">
  <swiper wx:if="{{swiper_stationery_v08_home_02.items && swiper_stationery_v08_home_02.items.length}}" style="height:{{(swiper_stationery_v08_home_02.height||340)}}rpx" autoplay="{{swiper_stationery_v08_home_02.autoplay !== false}}" interval="{{(swiper_stationery_v08_home_02.interval||3000)}}" indicator-dots="true" circular="true">
    <swiper-item wx:for="{{swiper_stationery_v08_home_02.items}}" wx:for-item="slide" wx:key="index">
      <image class="swiper-img" src="{{slide.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    </swiper-item>
  </swiper>
  <view wx:else class="article-empty">加载中...</view>
</view>
<view class="grid-nav mp-card" style="grid-template-columns:repeat(5,1fr)">
  <view class="grid-item" wx:for="{{gridNav_stationery_v08_home_03.items}}" wx:key="text" bindtap="onNavTap" data-url="{{item.navUrl}}">
    <image wx:if="{{item.iconSrc || item.icon}}" class="grid-icon" src="{{item.iconSrc || item.icon}}" mode="aspectFill"/>
    <text class="grid-text">{{item.text}}</text>
  </view>
</view>
<view class="notice-bar mp-card" style="color:{{(notice_stationery_v08_home_04.textColor||'#333333')}};background:{{(notice_stationery_v08_home_04.bgColor||'#ffffff')}};font-size:{{(notice_stationery_v08_home_04.fontSize||28)}}rpx">
  <text wx:if="{{notice_stationery_v08_home_04.showIcon !== false}}" class="notice-icon">📢</text>
  <text wx:if="{{notice_stationery_v08_home_04.prefixTitle}}" class="notice-prefix">{{notice_stationery_v08_home_04.prefixTitle}}</text>
  <view class="notice-viewport">
    <view class="notice-track {{notice_stationery_v08_home_04.trackClass || 'to-left'}}" style="animation-duration:{{(notice_stationery_v08_home_04.duration||'4.40s')}}">
      <text class="notice-text">{{notice_stationery_v08_home_04.content || '加载中...'}}</text>
      <text class="notice-text">{{notice_stationery_v08_home_04.content || '加载中...'}}</text>
    </view>
  </view>
</view>
<view class="promo-pair mp-card">
  <view class="promo-card" wx:for="{{promoPair_stationery_v08_home_05.items}}" wx:key="title" bindtap="onNavTap" data-url="{{item.navUrl}}" style="background:{{item.bgColor}}">
    <image wx:if="{{item.imageSrc || item.image}}" class="promo-img" src="{{item.imageSrc || item.image}}" mode="aspectFill"/>
    <text class="promo-title">{{item.title}}</text>
  </view>
</view>
<view class="product-box mp-card"><view class="product-section-head"><text class="product-section-title">开学热销</text><navigator url="/packageSys/pages/product-list/product-list?title=%E5%BC%80%E5%AD%A6%E7%83%AD%E9%94%80&component_id=stationery_v08_home_06" class="product-section-more" hover-class="none">更多</navigator></view><view class="product-grid" style="grid-template-columns:repeat(3,1fr)">
  <view class="product-card" wx:for="{{products_stationery_v08_home_06}}" wx:for-item="item" wx:for-index="idx" wx:key="idx" bindtap="goProduct" data-id="{{item.id}}">
    <image wx:if="{{item.imageSrc}}" class="product-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    <text class="product-name">{{item.name}}</text>
    <text class="product-price">¥{{item.price}}</text>
    <view class="product-add-cart" catchtap="addCartFromList" data-id="{{item.id}}" style="background:#e74c3c">+</view><button class="product-cart-btn product-buy-btn" catchtap="buyNowFromList" data-id="{{item.id}}" style="background:#e74c3c">立即购买</button>
  </view>
  <view wx:if="{{products_stationery_v08_home_06.length == 0}}" class="article-empty">暂无商品</view>
</view></view>
<view class="image-box mp-card"><image class="full-img" src="{{asset.url('/uploads/stock/stationery_9.jpg', siteRoot)}}" mode="widthFix"/></view>
<view class="promo-grid mp-card" style="grid-template-columns:repeat(3,1fr)"><view class="promo-grid-cell" style="background:#fff5f5"><text class="pg-badge">HOT</text><text class="pg-title">书写</text><text class="pg-sub">精选好物</text></view><view class="promo-grid-cell" style="background:#f5f8ff"><text class="pg-title">本册</text><text class="pg-sub">品质保障</text></view><view class="promo-grid-cell" style="background:#f5fff8"><text class="pg-title">办公</text><text class="pg-sub">办公必备</text></view><view class="promo-grid-cell" style="background:#fff8f0"><text class="pg-title">美术</text><text class="pg-sub">创意无限</text></view><view class="promo-grid-cell" style="background:#f8f5ff"><text class="pg-title">学生</text><text class="pg-sub">开学季</text></view><view class="promo-grid-cell" style="background:#f0f8ff"><text class="pg-title">收纳</text><text class="pg-sub">收纳整理</text></view></view>
