<wxs module="asset" src="../../utils/mp_asset.wxs"></wxs>
<view class="page">
<view class="login-banner" style="background:rgba(0,0,0,.7)"><text>登录解锁更多优惠</text><button class="login-banner-btn">立即登录</button></view>
<view class="swiper-wrap mp-card">
  <swiper wx:if="{{swiper_flower_v06_home_02.items && swiper_flower_v06_home_02.items.length}}" style="height:{{(swiper_flower_v06_home_02.height||400)}}rpx" autoplay="{{swiper_flower_v06_home_02.autoplay !== false}}" interval="{{(swiper_flower_v06_home_02.interval||3000)}}" indicator-dots="true" circular="true">
    <swiper-item wx:for="{{swiper_flower_v06_home_02.items}}" wx:for-item="slide" wx:key="index">
      <image class="swiper-img" src="{{slide.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    </swiper-item>
  </swiper>
  <view wx:else class="article-empty">加载中...</view>
</view>
<view class="waterfall mp-card" style="column-count:2"><view class="waterfall-item" style="height:160rpx"><text class="wf-title">玫瑰</text></view><view class="waterfall-item" style="height:200rpx"><text class="wf-title">百合</text></view><view class="waterfall-item" style="height:240rpx"><text class="wf-title">康乃馨</text></view><view class="waterfall-item" style="height:160rpx"><text class="wf-title">多肉</text></view></view>
<view class="promo-scroll mp-card"><view class="scroll-head"><text class="scroll-title">人气花束</text><text class="countdown">02:15:36</text></view><scroll-view scroll-x class="scroll-track"><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/flower_10.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">红玫瑰11枝</text><text class="product-price">¥88.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/flower_11.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">粉玫瑰19枝</text><text class="product-price">¥216.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/flower_12.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">香槟玫瑰</text><text class="product-price">¥344.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/flower_13.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">蓝色妖姬</text><text class="product-price">¥472.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/flower_14.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">多头玫瑰</text><text class="product-price">¥600.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/flower_15.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">玫瑰礼盒</text><text class="product-price">¥728.00</text></view></scroll-view></view>
<view class="product-box mp-card"><view class="product-section-head"><text class="product-section-title">商品列表</text><navigator url="/packageSys/pages/product-list/product-list?title=%E5%95%86%E5%93%81%E5%88%97%E8%A1%A8&component_id=flower_v06_home_05" class="product-section-more" hover-class="none">更多</navigator></view><view class="product-grid" style="grid-template-columns:repeat(2,1fr)">
  <view class="product-card" wx:for="{{products_flower_v06_home_05}}" wx:for-item="item" wx:for-index="idx" wx:key="idx" bindtap="goProduct" data-id="{{item.id}}">
    <image wx:if="{{item.imageSrc}}" class="product-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    <text class="product-name">{{item.name}}</text>
    <text class="product-price">¥{{item.price}}</text>
    <view class="product-add-cart" catchtap="addCartFromList" data-id="{{item.id}}" style="background:#9b59b6">+</view><button class="product-cart-btn product-buy-btn" catchtap="buyNowFromList" data-id="{{item.id}}" style="background:#e74c3c">立即购买</button>
  </view>
  <view wx:if="{{products_flower_v06_home_05.length == 0}}" class="article-empty">暂无商品</view>
</view></view>
</view>
<view class="app-modal-mask" wx:if="{{appModalShow}}" catchtouchmove="true">
  <view class="app-modal-box" catchtap="noop">
    <text class="app-modal-title">{{appModalTitle}}</text>
    <text class="app-modal-content">{{appModalContent}}</text>
    <button class="app-modal-btn" bindtap="closeAppModal">确定</button>
  </view>
</view>