<wxs module="asset" src="../../utils/mp_asset.wxs"></wxs>
<view class="page">
<view class="login-banner" style="background:rgba(0,0,0,.7)"><text>登录解锁更多优惠</text><button class="login-banner-btn">立即登录</button></view>
<view class="swiper-wrap mp-card">
  <swiper wx:if="{{swiper_beauty_v06_home_02.items && swiper_beauty_v06_home_02.items.length}}" style="height:{{(swiper_beauty_v06_home_02.height||400)}}rpx" autoplay="{{swiper_beauty_v06_home_02.autoplay !== false}}" interval="{{(swiper_beauty_v06_home_02.interval||3000)}}" indicator-dots="true" circular="true">
    <swiper-item wx:for="{{swiper_beauty_v06_home_02.items}}" wx:for-item="slide" wx:key="index">
      <image class="swiper-img" src="{{slide.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    </swiper-item>
  </swiper>
  <view wx:else class="article-empty">加载中...</view>
</view>
<view class="waterfall mp-card" style="column-count:2"><view class="waterfall-item" style="height:160rpx"><text class="wf-title">护肤</text></view><view class="waterfall-item" style="height:200rpx"><text class="wf-title">彩妆</text></view><view class="waterfall-item" style="height:240rpx"><text class="wf-title">面膜</text></view><view class="waterfall-item" style="height:160rpx"><text class="wf-title">香水</text></view></view>
<view class="promo-scroll mp-card"><view class="scroll-head"><text class="scroll-title">爆款美妆</text><text class="countdown">02:15:36</text></view><scroll-view scroll-x class="scroll-track"><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/beauty_10.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">保湿精华</text><text class="product-price">¥89.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/beauty_11.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">修护面霜</text><text class="product-price">¥218.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/beauty_12.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">防晒霜</text><text class="product-price">¥347.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/beauty_13.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">洁面乳</text><text class="product-price">¥476.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/beauty_14.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">爽肤水</text><text class="product-price">¥605.00</text></view><view class="scroll-card"><image class="scroll-img" src="{{asset.url('/uploads/stock/beauty_15.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">眼霜</text><text class="product-price">¥734.00</text></view></scroll-view></view>
<view class="product-box mp-card"><view class="product-section-head"><text class="product-section-title">商品列表</text><navigator url="/packageSys/pages/product-list/product-list?title=%E5%95%86%E5%93%81%E5%88%97%E8%A1%A8&component_id=beauty_v06_home_05" class="product-section-more" hover-class="none">更多</navigator></view><view class="product-grid" style="grid-template-columns:repeat(2,1fr)">
  <view class="product-card" wx:for="{{products_beauty_v06_home_05}}" wx:for-item="item" wx:for-index="idx" wx:key="idx" bindtap="goProduct" data-id="{{item.id}}">
    <image wx:if="{{item.imageSrc}}" class="product-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    <text class="product-name">{{item.name}}</text>
    <text class="product-price">¥{{item.price}}</text>
    <view class="product-add-cart" catchtap="addCartFromList" data-id="{{item.id}}" style="background:#9b59b6">+</view><button class="product-cart-btn product-buy-btn" catchtap="buyNowFromList" data-id="{{item.id}}" style="background:#e74c3c">立即购买</button>
  </view>
  <view wx:if="{{products_beauty_v06_home_05.length == 0}}" class="article-empty">暂无商品</view>
</view></view>
</view>
<view class="app-modal-mask" wx:if="{{appModalShow}}" catchtouchmove="true">
  <view class="app-modal-box" catchtap="noop">
    <text class="app-modal-title">{{appModalTitle}}</text>
    <text class="app-modal-content">{{appModalContent}}</text>
    <button class="app-modal-btn" bindtap="closeAppModal">确定</button>
  </view>
</view>