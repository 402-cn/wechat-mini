.page{padding:24rpx;background:#f5f6f8;min-height:100vh;box-sizing:border-box}.addr-pick{background:#fff;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx}.pick-label{display:block;font-size:24rpx;color:#888;margin-bottom:8rpx}.pick-val{font-size:28rpx;color:#333}.form-row{margin-bottom:24rpx;background:#fff;border-radius:12rpx;padding:20rpx;box-sizing:border-box}.form-row text{display:block;font-size:26rpx;color:#666;margin-bottom:12rpx}.form-row input{display:block;width:100%;height:80rpx;line-height:80rpx;border:1px solid #e8e8e8;border-radius:12rpx;padding:0 20rpx;box-sizing:border-box;font-size:28rpx;background:#fafafa;color:#333}.form-row textarea{display:block;width:100%;min-height:160rpx;line-height:1.5;border:1px solid #e8e8e8;border-radius:12rpx;padding:20rpx;box-sizing:border-box;font-size:28rpx;background:#fafafa;color:#333}.pay-btns{display:flex;gap:20rpx;margin-top:40rpx}.btn-balance{flex:1;background:#2ecc71;color:#fff}.btn-wx{flex:1;background:#07c160;color:#fff}
.app-modal-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 10000;
  background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center;
  padding: 48rpx; box-sizing: border-box;
}
.app-modal-box {
  width: 100%; max-width: 560rpx; background: #fff; border-radius: 20rpx;
  padding: 40rpx 32rpx 32rpx; box-sizing: border-box;
}
.app-modal-title { display: block; font-size: 32rpx; font-weight: 600; color: #333; text-align: center; margin-bottom: 20rpx; }
.app-modal-content { display: block; font-size: 28rpx; color: #666; line-height: 1.6; text-align: center; margin-bottom: 32rpx; word-break: break-all; }
.app-modal-btn { width: 100%; background: var(--primary-color, #2ecc71); color: #fff; border-radius: 12rpx; font-size: 30rpx; }

.mp-shell.has-tab { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
.app-tabbar-mp {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 9999;
  display: flex; align-items: stretch; justify-content: space-around;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff; border-top: 1px solid #eee; box-sizing: border-box;
  pointer-events: auto;
}
.tab-item-mp { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; pointer-events: auto; }
.tab-icon-mp { width: 44rpx; height: 44rpx; margin-bottom: 4rpx; }
.tab-text-mp { font-size: 20rpx; line-height: 1.2; }
