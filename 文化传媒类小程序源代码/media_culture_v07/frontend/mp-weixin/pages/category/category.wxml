<wxs module="asset" src="../../utils/mp_asset.wxs"></wxs>
<view class="page">
<view class="title-bar mp-card"><text class="title">商品分类</text><text class="sub">文化传媒</text></view>
<view class="search-bar mp-card" style="background:#ffffff"><input class="mb-input" placeholder="搜索传媒服务"/></view>
<view class="grid-nav mp-card" style="grid-template-columns:repeat(5,1fr)">
  <view class="grid-item" wx:for="{{gridNav_media_culture_v07_cat_03.items}}" wx:key="text" bindtap="onNavTap" data-url="{{item.navUrl}}">
    <image wx:if="{{item.iconSrc || item.icon}}" class="grid-icon" src="{{item.iconSrc || item.icon}}" mode="aspectFill"/>
    <text class="grid-text">{{item.text}}</text>
  </view>
</view>
<view class="product-box mp-card"><view class="product-section-head"><text class="product-section-title">商品列表</text><navigator url="/packageSys/pages/product-list/product-list?title=%E5%95%86%E5%93%81%E5%88%97%E8%A1%A8&component_id=media_culture_v07_cat_04" class="product-section-more" hover-class="none">更多</navigator></view><view class="product-grid" style="grid-template-columns:repeat(2,1fr)">
  <view class="product-card" wx:for="{{products_media_culture_v07_cat_04}}" wx:for-item="item" wx:for-index="idx" wx:key="idx" bindtap="goProduct" data-id="{{item.id}}">
    <image wx:if="{{item.imageSrc}}" class="product-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    <text class="product-name">{{item.name}}</text>
    <text class="product-price">¥{{item.price}}</text>
    <view class="product-add-cart" catchtap="addCartFromList" data-id="{{item.id}}" style="background:#795548">+</view><button class="product-cart-btn product-buy-btn" catchtap="buyNowFromList" data-id="{{item.id}}" style="background:#e74c3c">立即购买</button>
  </view>
  <view wx:if="{{products_media_culture_v07_cat_04.length == 0}}" class="article-empty">暂无商品</view>
</view></view>
</view>
<view class="app-modal-mask" wx:if="{{appModalShow}}" catchtouchmove="true">
  <view class="app-modal-box" catchtap="noop">
    <text class="app-modal-title">{{appModalTitle}}</text>
    <text class="app-modal-content">{{appModalContent}}</text>
    <button class="app-modal-btn" bindtap="closeAppModal">确定</button>
  </view>
</view>