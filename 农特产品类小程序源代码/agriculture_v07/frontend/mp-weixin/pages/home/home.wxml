<wxs module="asset" src="../../utils/mp_asset.wxs"></wxs>
<view class="page page-flush-top">
<view class="page-header mp-card" style="background:#795548"><view class="header-top"><text class="brand">乡土好物</text><text>💬</text></view><view class="search-row"><text>📍 当前定位</text><input placeholder="搜索农特产品" disabled/></view></view>
<view class="image-box mp-card"><image class="full-img" src="{{asset.url('/uploads/stock/agriculture_9.jpg', siteRoot)}}" mode="widthFix"/></view>
<view class="rich-text mp-card"><rich-text nodes="<p><strong>乡土好物</strong> — 农特产品行业全套模板，含首页/分类/购物车/我的等10个页面</p>"/></view>
<view class="grid-nav mp-card" style="grid-template-columns:repeat(2,1fr)">
  <view class="grid-item" wx:for="{{gridNav_agriculture_v07_home_04.items}}" wx:key="text" bindtap="onNavTap" data-url="{{item.navUrl}}">
    <image wx:if="{{item.iconSrc || item.icon}}" class="grid-icon" src="{{item.iconSrc || item.icon}}" mode="aspectFill"/>
    <text class="grid-text">{{item.text}}</text>
  </view>
</view>
<view class="stats-row mp-card"><view class="stats-cell"><text class="stats-value">1000+</text><text class="stats-label">服务客户</text></view><view class="stats-cell"><text class="stats-value">10年</text><text class="stats-label">行业经验</text></view><view class="stats-cell"><text class="stats-value">99%</text><text class="stats-label">好评率</text></view></view>
<view class="article-box mp-card"><view class="article-section-head"><text class="article-section-title">企业动态</text><navigator url="/packageSys/pages/article-list/article-list?title=%E4%BC%81%E4%B8%9A%E5%8A%A8%E6%80%81&component_id=agriculture_v07_home_06" class="article-section-more" hover-class="none">更多</navigator></view><view class="article-list">
  <view class="article-item" wx:for="{{articles_agriculture_v07_home_06}}" wx:for-item="item" wx:for-index="idx" wx:key="idx" bindtap="goArticle" data-id="{{item.id}}">
    <image wx:if="{{item.coverSrc}}" class="article-cover" src="{{item.coverSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    <view class="article-body">
      <text class="article-title">{{item.title}}</text>
      <text class="article-summary">{{item.summary}}</text>
    </view>
  </view>
  <view wx:if="{{articles_agriculture_v07_home_06.length == 0}}" class="article-empty">暂无文章</view>
</view></view>
<view class="form-box mp-card message-board"><text class="form-title mb-title">在线留言</text><view class="mb-field"><text class="mb-label">姓名</text><input class="mb-input" type="text" placeholder="请输入姓名"/></view><view class="mb-field"><text class="mb-label">手机号</text><input class="mb-input" type="number" placeholder="请输入手机号"/></view><view class="mb-field"><text class="mb-label">留言</text><textarea class="mb-input" placeholder="请输入留言内容" auto-height/></view><button class="mb-submit" bindtap="submitForm" data-form-id="agriculture_v07_home_contact">提交</button></view>
</view>
<view class="app-modal-mask" wx:if="{{appModalShow}}" catchtouchmove="true">
  <view class="app-modal-box" catchtap="noop">
    <text class="app-modal-title">{{appModalTitle}}</text>
    <text class="app-modal-content">{{appModalContent}}</text>
    <button class="app-modal-btn" bindtap="closeAppModal">确定</button>
  </view>
</view>