  <view class="product-card" wx:for="{{products_fashion_v01_home_11}}" wx:for-item="item" wx:for-index="idx" wx:key="idx" bindtap="goProduct" data-id="{{item.id}}">
    <image wx:if="{{item.imageSrc}}" class="product-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    <view class="product-list-body"><text class="product-name">{{item.name}}</text><view class="product-list-foot"><text class="product-price">¥{{item.price}}</text><button class="product-cart-btn" catchtap="addCartFromList" data-id="{{item.id}}" style="background:#e74c3c">加入购物车</button><button class="product-cart-btn product-buy-btn" catchtap="buyNowFromList" data-id="{{item.id}}" style="background:#e74c3c">立即购买</button></view></view>
  </view>
  <view wx:if="{{products_fashion_v01_home_11.length == 0}}" class="article-empty">暂无商品</view>
</view></view>
<view class="promo-banner mp-card"><view class="banner-row" style="background:#e8f5e9"><image class="banner-img" src="{{asset.url('/uploads/stock/fashion_48.jpg', siteRoot)}}" mode="aspectFill"/><view class="banner-text"><text class="banner-title">新品季</text><text class="banner-sub">春季新款</text></view></view><view class="banner-grid" style="grid-template-columns:repeat(2,1fr)"><view class="product-card" bindtap="goProduct" data-id="11"><image class="product-img" src="{{asset.url('/uploads/stock/fashion_20.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">卫衣</text><text class="product-price">¥615.00</text><view class="product-add-cart" catchtap="addCartFromList" data-id="11">+</view></view><view class="product-card" bindtap="goProduct" data-id="12"><image class="product-img" src="{{asset.url('/uploads/stock/fashion_21.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">牛仔裤</text><text class="product-price">¥744.00</text><view class="product-add-cart" catchtap="addCartFromList" data-id="12">+</view></view><view class="product-card" bindtap="goProduct" data-id="13"><image class="product-img" src="{{asset.url('/uploads/stock/fashion_22.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">小白鞋</text><text class="product-price">¥99.00</text><view class="product-add-cart" catchtap="addCartFromList" data-id="13">+</view></view><view class="product-card" bindtap="goProduct" data-id="14"><image class="product-img" src="{{asset.url('/uploads/stock/fashion_23.jpg', siteRoot)}}" mode="aspectFill"/><text class="product-name">高跟鞋</text><text class="product-price">¥228.00</text><view class="product-add-cart" catchtap="addCartFromList" data-id="14">+</view></view></view></view>
<view class="product-box mp-card"><view class="product-section-head"><text class="product-section-title">商品列表</text><navigator url="/packageSys/pages/product-list/product-list?title=%E5%95%86%E5%93%81%E5%88%97%E8%A1%A8&component_id=fashion_v01_home_13" class="product-section-more" hover-class="none">更多</navigator></view><view class="product-grid" style="grid-template-columns:repeat(2,1fr)">
  <view class="product-card" wx:for="{{products_fashion_v01_home_13}}" wx:for-item="item" wx:for-index="idx" wx:key="idx" bindtap="goProduct" data-id="{{item.id}}">
    <image wx:if="{{item.imageSrc}}" class="product-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    <text class="product-name">{{item.name}}</text>
    <text class="product-price">¥{{item.price}}</text>
    <view class="product-add-cart" catchtap="addCartFromList" data-id="{{item.id}}" style="background:#9b59b6">+</view><button class="product-cart-btn product-buy-btn" catchtap="buyNowFromList" data-id="{{item.id}}" style="background:#e74c3c">立即购买</button>
  </view>
  <view wx:if="{{products_fashion_v01_home_13.length == 0}}" class="article-empty">暂无商品</view>
</view></view>
</view>
<view class="app-modal-mask" wx:if="{{appModalShow}}" catchtouchmove="true">
  <view class="app-modal-box" catchtap="noop">
    <text class="app-modal-title">{{appModalTitle}}</text>
    <text class="app-modal-content">{{appModalContent}}</text>
    <button class="app-modal-btn" bindtap="closeAppModal">确定</button>
  </view>
</view>