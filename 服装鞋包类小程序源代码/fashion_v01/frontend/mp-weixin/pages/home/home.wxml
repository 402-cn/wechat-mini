<wxs module="asset" src="../../utils/mp_asset.wxs"></wxs>
<view class="page page-flush-top">
<view class="page-header mp-card" style="background:#9b59b6"><view class="header-top"><text class="brand">潮流衣橱</text><text>💬</text></view><view class="search-row"><text>📍 当前定位</text><input placeholder="搜索服装鞋包" disabled/></view></view>
<view class="grid-nav mp-card" style="grid-template-columns:repeat(4,1fr)">
  <view class="grid-item" wx:for="{{gridNav_fashion_v01_home_02.items}}" wx:key="text" bindtap="onNavTap" data-url="{{item.navUrl}}">
    <image wx:if="{{item.iconSrc || item.icon}}" class="grid-icon" src="{{item.iconSrc || item.icon}}" mode="aspectFill"/>
    <text class="grid-text">{{item.text}}</text>
  </view>
</view>
<view class="swiper-wrap mp-card">
  <swiper wx:if="{{swiper_fashion_v01_home_03.items && swiper_fashion_v01_home_03.items.length}}" style="height:{{(swiper_fashion_v01_home_03.height||320)}}rpx" autoplay="{{swiper_fashion_v01_home_03.autoplay !== false}}" interval="{{(swiper_fashion_v01_home_03.interval||3000)}}" indicator-dots="true" circular="true">
    <swiper-item wx:for="{{swiper_fashion_v01_home_03.items}}" wx:for-item="slide" wx:key="index">
      <image class="swiper-img" src="{{slide.imageSrc}}" mode="aspectFill" lazy-load="{{false}}"/>
    </swiper-item>
  </swiper>
  <view wx:else class="article-empty">加载中...</view>
</view>
<view class="notice-bar mp-card" style="color:{{(notice_fashion_v01_home_04.textColor||'#333333')}};background:{{(notice_fashion_v01_home_04.bgColor||'#ffffff')}};font-size:{{(notice_fashion_v01_home_04.fontSize||28)}}rpx">
  <text wx:if="{{notice_fashion_v01_home_04.showIcon !== false}}" class="notice-icon">📢</text>
  <text wx:if="{{notice_fashion_v01_home_04.prefixTitle}}" class="notice-prefix">{{notice_fashion_v01_home_04.prefixTitle}}</text>
  <view class="notice-viewport">
    <view class="notice-track {{notice_fashion_v01_home_04.trackClass || 'to-left'}}" style="animation-duration:{{(notice_fashion_v01_home_04.duration||'4.40s')}}">
      <text class="notice-text">{{notice_fashion_v01_home_04.content || '加载中...'}}</text>
      <text class="notice-text">{{notice_fashion_v01_home_04.content || '加载中...'}}</text>
    </view>
  </view>
</view>
<view class="grid-nav mp-card" style="grid-template-columns:repeat(3,1fr)">
  <view class="grid-item" wx:for="{{gridNav_fashion_v01_home_05.items}}" wx:key="text" bindtap="onNavTap" data-url="{{item.navUrl}}">
    <image wx:if="{{item.iconSrc || item.icon}}" class="grid-icon" src="{{item.iconSrc || item.icon}}" mode="aspectFill"/>
    <text class="grid-text">{{item.text}}</text>
  </view>
</view>
<view class="grid-nav mp-card" style="grid-template-columns:repeat(5,1fr)">
  <view class="grid-item" wx:for="{{gridNav_fashion_v01_home_06.items}}" wx:key="text" bindtap="onNavTap" data-url="{{item.navUrl}}">
    <image wx:if="{{item.iconSrc || item.icon}}" class="grid-icon" src="{{item.iconSrc || item.icon}}" mode="aspectFill"/>
    <text class="grid-text">{{item.text}}</text>
  </view>
</view>
<view class="promo-pair mp-card">
  <view class="promo-card" wx:for="{{promoPair_fashion_v01_home_07.items}}" wx:key="title" bindtap="onNavTap" data-url="{{item.navUrl}}" style="background:{{item.bgColor}}">
    <image wx:if="{{item.imageSrc || item.image}}" class="promo-img" src="{{item.imageSrc || item.image}}" mode="aspectFill"/>
    <text class="promo-title">{{item.title}}</text>
  </view>
</view>
<view class="promo-pair mp-card">
  <view class="promo-card" wx:for="{{promoPair_fashion_v01_home_08.items}}" wx:key="title" bindtap="onNavTap" data-url="{{item.navUrl}}" style="background:{{item.bgColor}}">
    <image wx:if="{{item.imageSrc || item.image}}" class="promo-img" src="{{item.imageSrc || item.image}}" mode="aspectFill"/>
    <text class="promo-title">{{item.title}}</text>
  </view>
</view>
