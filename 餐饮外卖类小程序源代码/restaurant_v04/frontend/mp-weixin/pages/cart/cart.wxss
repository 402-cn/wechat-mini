
.cart-head-block { margin-bottom: 24rpx; }
.cart-empty { text-align: center; padding: 48rpx 0; color: #999; font-size: 28rpx; }
.cart-list { background: #fff; border-radius: 16rpx; padding: 16rpx 24rpx; }
.cart-item { display: flex; gap: 16rpx; padding: 20rpx 0; border-bottom: 1px solid #f0f0f0; }
.cart-thumb { width: 144rpx; height: 144rpx; border-radius: 12rpx; flex-shrink: 0; }
.cart-info { flex: 1; min-width: 0; }
.cart-name { font-size: 28rpx; display: block; }
.cart-price { color: #e74c3c; font-size: 28rpx; display: block; margin-top: 8rpx; }
.cart-qty { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.cart-del { margin-left: auto; color: #e74c3c; font-size: 24rpx; }
.cart-foot { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0 8rpx; }

.app-modal-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 10000;
  background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center;
  padding: 48rpx; box-sizing: border-box;
}
.app-modal-box {
  width: 100%; max-width: 560rpx; background: #fff; border-radius: 20rpx;
  padding: 40rpx 32rpx 32rpx; box-sizing: border-box;
}
.app-modal-title { display: block; font-size: 32rpx; font-weight: 600; color: #333; text-align: center; margin-bottom: 20rpx; }
.app-modal-content { display: block; font-size: 28rpx; color: #666; line-height: 1.6; text-align: center; margin-bottom: 32rpx; word-break: break-all; }
.app-modal-btn { width: 100%; background: var(--primary-color, #2ecc71); color: #fff; border-radius: 12rpx; font-size: 30rpx; }
