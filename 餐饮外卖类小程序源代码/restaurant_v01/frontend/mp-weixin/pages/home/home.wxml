<wxs module="asset" src="../../utils/mp_asset.wxs"></wxs>
<view class="page page-flush-top">
<view class="page-header mp-card" style="background:#e74c3c"><view class="header-top"><text class="brand">美味到家</text><text>💬</text></view><view class="search-row"><text>📍 当前定位</text><input placeholder="搜索菜品" disabled/></view></view>
<view class="grid-nav mp-card" style="grid-template-columns:repeat(4,1fr)">
  <view class="grid-item" wx:for="{{gridNav_restaurant_v01_home_02.items}}" wx:key="text" bindtap="onNavTap" data-url="{{item.navUrl}}">
    <image wx:if="{{item.iconSrc || item.icon}}" class="grid-icon" src="{{item.iconSrc || item.icon}}" mode="aspectFill"/>
    <text class="grid-text">{{item.text}}</text>
  </view>
</view>
<view class="swiper-wrap mp-card">
  <swiper wx:if="{{swiper_restaurant_v01_home_03.items && swiper_restaurant_v01_home_03.items.length}}" style="height:{{(swiper_restaurant_v01_home_03.height||320)}}rpx" autoplay="{{swiper_restaurant_v01_home_03.autoplay !== false}}" interval="{{(swiper_restaurant_v01_home_03.interval||3000)}}" indicator-dots="true" circular="true">
